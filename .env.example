# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/landed_cost

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Auth: API Keys (empty = auth disabled for development)
API_KEYS=[]

# JWT Secret (generate a random 64-char string for production)
JWT_SECRET=change-me-in-production-use-long-random-string

# OAuth - Google (get from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - GitHub (get from https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Rate limiting
DAILY_CALC_LIMIT_USER=50
DAILY_CALC_LIMIT_ADMIN=99999
